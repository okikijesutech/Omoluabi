generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////######
// ENUMS
////////////////######

enum Role {
  LEARNER
  CONTRIBUTOR
  REVIEWER
  ADMIN
}

enum KnowledgeType {
  WORD
  PHRASE
  PROVERB
  ORIKI
  GRAMMAR
  HISTORY
  CULTURAL_NOTE
}

enum ContributionType {
  CREATE
  EDIT
  DIALECT_VARIATION
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  CULTURAL_DEPTH
}

enum EntityType {
  KNOWLEDGE_UNIT
  KNOWLEDGE_VARIATION
  USER
}

enum ChangeType {
  EDIT
  DELETE_ATTEMPT
  MERGE_ATTEMPT
}

enum CouncilStatus {
  OPEN
  RESOLVED
}

enum CouncilDecision {
  APPROVED
  REJECTED
  ARCHIVED
}

enum VoteDecision {
  APPROVE
  REJECT
}

//////////////////////
// USER & ROLES
//////////////////////

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  role          Role     @default(LEARNER)

  // Trust Metrics
  trustScore        Float   @default(0.0)
  approvedCount     Int     @default(0)
  rejectedCount     Int     @default(0)
  reviewAccuracy    Float   @default(0.0)
  totalReviews      Int     @default(0)
  correctReviews    Int     @default(0)

  contributions     Contribution[]
  reviews           Review[]
  progress          UserProgress[]
  revisionHistories RevisionHistory[]
  councilVotes      CouncilVote[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

//////////////////////
// DIALECT SYSTEM
//////////////////////

model Dialect {
  id          String   @id @default(uuid())
  name        String   @unique
  region      String?
  description String?

  // Hierarchy support
  parentDialectId String?
  parentDialect   Dialect?  @relation("DialectHierarchy", fields: [parentDialectId], references: [id])
  children        Dialect[] @relation("DialectHierarchy")

  variations  KnowledgeVariation[]

  createdAt   DateTime @default(now())
}

//////////////////////
// KNOWLEDGE CORE
//////////////////////

model KnowledgeUnit {
  id              String           @id @default(uuid())
  type            KnowledgeType
  title           String           // Public display title
  slug            String           @unique // SEO & Canonical URL part
  normalizedTitle String?          // For tone-insensitive search
  description     String?          // cultural context

  isArchived      Boolean          @default(false)

  variations      KnowledgeVariation[]
  contributions   Contribution[]
  learningUnits   LearningPathUnit[]
  progressRecords UserProgress[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([slug])
}

model KnowledgeVariation {
  id               String         @id @default(uuid())

  knowledgeUnit    KnowledgeUnit  @relation(fields: [knowledgeUnitId], references: [id])
  knowledgeUnitId  String

  dialect          Dialect        @relation(fields: [dialectId], references: [id])
  dialectId        String

  textWithTone     String         // e.g. Ọmọlúàbí
  phoneticGuide    String?
  notes            String?

  audioUrl         String?
  isArchived       Boolean        @default(false)

  createdAt        DateTime       @default(now())
  contributions    Contribution[]

  @@unique([knowledgeUnitId, dialectId])
}

//////////////////////
// CONTRIBUTION SYSTEM
//////////////////////

model Contribution {
  id               String             @id @default(uuid())
  type             ContributionType
  status           ContributionStatus @default(PENDING)

  content          Json               // proposed changes
  comment          String?

  knowledgeUnit    KnowledgeUnit?     @relation(fields: [knowledgeUnitId], references: [id])
  knowledgeUnitId  String?

  knowledgeVariation   KnowledgeVariation? @relation(fields: [knowledgeVariationId], references: [id])
  knowledgeVariationId String?

  author           User               @relation(fields: [authorId], references: [id])
  authorId         String

  reviews          Review[]
  revisionHistories RevisionHistory[]
  councilCases     CouncilCase[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Review {
  id              String       @id @default(uuid())

  contribution    Contribution @relation(fields: [contributionId], references: [id])
  contributionId  String

  reviewer        User         @relation(fields: [reviewerId], references: [id])
  reviewerId      String

  approved        Boolean
  comment         String?

  createdAt       DateTime     @default(now())
}

//////////////////////
// GOVERNANCE LAYER
//////////////////////

model RevisionHistory {
  id                String   @id @default(uuid())

  entityType        EntityType
  entityId          String
  entityVersion     Int      @default(1)

  previousData      Json      // Full snapshot before change
  newData           Json      // Proposed or applied change

  changeType        ChangeType

  contributionId    String?
  contribution      Contribution? @relation(fields: [contributionId], references: [id])

  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id])

  isRestored        Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([entityId])
}

model CouncilCase {
  id               String   @id @default(uuid())

  contributionId   String
  contribution     Contribution @relation(fields: [contributionId], references: [id])

  status           CouncilStatus @default(OPEN)

  openedAt         DateTime @default(now())
  resolvedAt       DateTime?

  decision         CouncilDecision?

  councilVotes     CouncilVote[]
}

model CouncilVote {
  id              String @id @default(uuid())

  councilCaseId   String
  councilCase     CouncilCase @relation(fields: [councilCaseId], references: [id])

  memberId        String
  member          User @relation(fields: [memberId], references: [id])

  decision        VoteDecision

  createdAt       DateTime @default(now())
}

//////////////////////
// LEARNING LAYER
//////////////////////

model LearningPath {
  id          String        @id @default(uuid())
  level       LearningLevel
  title       String
  description String?

  units       LearningPathUnit[]

  createdAt   DateTime      @default(now())
}

model LearningPathUnit {
  id              String         @id @default(uuid())

  learningPath    LearningPath   @relation(fields: [learningPathId], references: [id])
  learningPathId  String

  knowledgeUnit   KnowledgeUnit  @relation(fields: [knowledgeUnitId], references: [id])
  knowledgeUnitId String

  order           Int

  @@unique([learningPathId, order])
}

//////////////////////
// USER PROGRESS
//////////////////////

model UserProgress {
  id              String         @id @default(uuid())

  user            User           @relation(fields: [userId], references: [id])
  userId          String

  knowledgeUnit   KnowledgeUnit  @relation(fields: [knowledgeUnitId], references: [id])
  knowledgeUnitId String

  completed       Boolean        @default(false)
  lastReviewedAt  DateTime?

  createdAt       DateTime       @default(now())

  @@unique([userId, knowledgeUnitId], name: "user_knowledge_unique")
}
