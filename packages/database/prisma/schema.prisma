generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  username          String           @unique
  passwordHash      String
  role              Role             @default(CONTRIBUTOR)
  culturalTitleId   String?
  contributionCount Int              @default(0) // Gamification: Global Tracking
  contributions     Contribution[]
  reviews           Review[]
  lessonProgress    LessonProgress[]
  votes             Vote[]
  culturalTitle     CulturalTitle?   @relation(fields: [culturalTitleId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum Role {
  FOUNDER
  REVIEWER
  TRUSTED_CONTRIBUTOR
  CONTRIBUTOR
}

model Language {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  courses   Course[]
  createdAt DateTime @default(now())
}

model Course {
  id          String   @id @default(uuid())
  languageId  String
  language    Language @relation(fields: [languageId], references: [id])
  title       String
  description String?
  levels      Level[]
  createdAt   DateTime @default(now())
}

model Level {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  title    String
  order    Int
  modules  Module[]
}

model Module {
  id      String   @id @default(uuid())
  levelId String
  level   Level    @relation(fields: [levelId], references: [id])
  title   String
  order   Int
  lessons Lesson[]
}

model Lesson {
  id            String          @id @default(uuid())
  moduleId      String
  module        Module          @relation(fields: [moduleId], references: [id])
  title         String
  content       String          // Note: Text content payload
  contentType   ContentType     @default(LESSON)
  dialectNotes  DialectNote[]
  exercises     Exercise[]
  contributions Contribution[]  // Note: Provides lesson_version_history
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Exercise {
  id       String       @id @default(uuid())
  lessonId String
  lesson   Lesson       @relation(fields: [lessonId], references: [id])
  question String
  answer   String
  type     ExerciseType
}

enum ContentType {
  LESSON
  PROVERB
  ORIKI
  CULTURAL_INSIGHT
  HISTORY_NOTE
}

enum ExerciseType {
  MULTIPLE_CHOICE
  TRANSLATE
  MATCH
  LISTEN
  AUDIO
  IDENTIFY
}

model DialectNote {
  id          String  @id @default(uuid())
  lessonId    String
  lesson      Lesson  @relation(fields: [lessonId], references: [id])
  dialectName String
  variation   String
  explanation String?
}

model Contribution {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  lessonId  String?
  lesson    Lesson?            @relation(fields: [lessonId], references: [id])
  content   String
  status    ContributionStatus @default(PENDING) // Serves as approval_state / review_status
  reviews   Review[]
  votes     Vote[]
  createdAt DateTime           @default(now())
}

model Review {
  id             String       @id @default(uuid())
  contributionId String
  contribution   Contribution @relation(fields: [contributionId], references: [id])
  reviewerId     String
  reviewer       User         @relation(fields: [reviewerId], references: [id])
  comment        String?
  approved       Boolean
  disputeFlag    Boolean      @default(false) // Moderation: track controversial reviews
  createdAt      DateTime     @default(now())
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Vote {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  contributionId String
  contribution   Contribution @relation(fields: [contributionId], references: [id])
  value          Int          // +1 or -1
}

model CulturalTitle {
  id                    String @id @default(uuid())
  name                  String
  description           String
  requiredContributions Int
  users                 User[]
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lessonId  String
  completed Boolean  @default(false)
  score     Int?
  updatedAt DateTime @updatedAt
}
