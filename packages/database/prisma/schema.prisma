generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// LAYER 5: USER & ROLES
// ============================================

model User {
  id           String @id @default(uuid())
  email        String @unique
  username     String @unique
  passwordHash String
  role         Role   @default(LEARNER)

  culturalTitleId String?
  culturalTitle   CulturalTitle? @relation(fields: [culturalTitleId], references: [id])

  // Gamification tied to approved contributions
  contributionCount Int @default(0)

  contributions Contribution[]
  reviews       Review[]
  votes         Vote[]
  progress      UserProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  REVIEWER
  CONTRIBUTOR
  LEARNER
}

// Cultural progression
model CulturalTitle {
  id                    String @id @default(uuid())
  name                  String // Akẹ́kọ̀, Olùkọ́, Aṣáájú Ìmọ̀
  description           String
  requiredContributions Int
  users                 User[]
}

model UserProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  knowledgeUnitId String
  knowledgeUnit   KnowledgeUnit @relation(fields: [knowledgeUnitId], references: [id], onDelete: Cascade)

  status ProgressStatus @default(NOT_STARTED)
  score  Int?

  lastReviewedAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([userId, knowledgeUnitId])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  MASTERED
}

// ============================================
// LAYER 1: KNOWLEDGE CORE (Foundation)
// ============================================

model KnowledgeUnit {
  id           String        @id @default(uuid())
  type         KnowledgeType
  standardText String // Anchor text
  translation  String // Foundational translation

  phoneticExplanation String? // Breakdown of pronunciation
  culturalContext     String? // Philosophical/Historical Context
  sourceAttribution   String? // E.g., "Ìwé Òwe Yorùbá, J.O. Ajibola"

  validationStatus ValidationStatus @default(DRAFT)

  // Relations
  dialectVariations KnowledgeUnitVariation[]
  learningPathUnits LearningPathUnit[]
  contributions     Contribution[]
  userProgress      UserProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum KnowledgeType {
  WORD
  PHRASE
  PROVERB
  ORIKI
  GRAMMAR_RULE
  HISTORY_NOTE
  CULTURAL_INSIGHT
}

enum ValidationStatus {
  DRAFT
  COMMUNITY_VERIFIED
  EXPERT_VERIFIED
}

// ============================================
// LAYER 2: DIALECT MODEL
// ============================================

model Dialect {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., Ìjẹ̀bú, Ẹ̀gbá, Ọ̀yọ́, Èkiti, Ìjèsà
  region      String?
  description String?

  variations KnowledgeUnitVariation[]
}

model KnowledgeUnitVariation {
  id String @id @default(uuid())

  knowledgeUnitId String
  knowledgeUnit   KnowledgeUnit @relation(fields: [knowledgeUnitId], references: [id], onDelete: Cascade)

  dialectId String
  dialect   Dialect @relation(fields: [dialectId], references: [id], onDelete: Restrict)

  textWithTone        String // Specific spelling/tonal variation for this dialect
  phoneticExplanation String? // Nuance description (why it differs from standard)
  notes               String?
  audioUrl            String? // Audio preservation

  @@unique([knowledgeUnitId, dialectId])
}

// ============================================
// LAYER 4: LEARNING LAYER (Generated)
// ============================================

model LearningPath {
  id          String  @id @default(uuid())
  level       String // e.g., Beginner, Intermediate, Advanced, Cultural Depth
  title       String
  description String?
  order       Int

  units LearningPathUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningPathUnit {
  id String @id @default(uuid())

  learningPathId String
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  knowledgeUnitId String
  knowledgeUnit   KnowledgeUnit @relation(fields: [knowledgeUnitId], references: [id], onDelete: Cascade)

  order Int // Sequence within the path

  @@unique([learningPathId, knowledgeUnitId])
}

// ============================================
// LAYER 3: CONTRIBUTION & VALIDATION
// ============================================

model Contribution {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  knowledgeUnitId String?
  knowledgeUnit   KnowledgeUnit? @relation(fields: [knowledgeUnitId], references: [id], onDelete: SetNull)

  type    ContributionType
  content String // JSON payload defining the state

  status ContributionStatus @default(PENDING)

  reviewCount   Int @default(0)
  approvalScore Int @default(0) // Sum of votes +1/-1

  reviews Review[]
  votes   Vote[]

  createdAt DateTime @default(now())
}

enum ContributionType {
  NEW_KNOWLEDGE
  EDIT_KNOWLEDGE
  DIALECT_ADDITION
  AUDIO_SUBMISSION
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id String @id @default(uuid())

  contributionId String
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  decision ReviewDecision
  comment  String?

  createdAt DateTime @default(now())
}

enum ReviewDecision {
  APPROVE
  REQUEST_CHANGES
  REJECT
  ESCALATE_TO_COUNCIL
}

model Vote {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contributionId String
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  value Int // +1 or -1

  @@unique([userId, contributionId])
}
